{
  "name": "app",
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "esbuild": "^0.25.11",
    "playwright": "^1.56.1"
  },
  "scripts": {
    "build": "esbuild app/javascript/application.js --bundle --minify --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets --loader:.js=jsx --loader:.ts=ts --loader:.tsx=tsx --jsx=automatic && npm run --silent prerender",
    "prerender": "esbuild script/prerender.tsx --bundle --platform=node --format=esm --packages=external --outfile=tmp/prerender.mjs --loader:.js=jsx --jsx=automatic --log-level=warning && node tmp/prerender.mjs",
    "build:css": "npx @tailwindcss/cli -i ./app/assets/stylesheets/application.tailwind.css -o ./app/assets/builds/application.css --minify",
    "dev:js": "esbuild app/javascript/application.js --bundle --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets --loader:.js=jsx --loader:.ts=ts --loader:.tsx=tsx --jsx=automatic --watch",
    "dev:css": "npx @tailwindcss/cli -i ./app/assets/stylesheets/application.tailwind.css -o ./app/assets/builds/application.css --watch",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test",
    "test:rules": "node script/test_solo_rules.cjs",
    "test:daily": "node script/test_daily.cjs",
    "test:cards": "node script/test_card_artwork.cjs",
    "test:demo": "node script/test_rules_demo.cjs",
    "assets:brand": "node script/generate_brand_assets.cjs"
  },
  "dependencies": {
    "@rails/actioncable": "^8.0.300",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/cli": "^4.1.14",
    "@types/node": "^24.8.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3"
  }
}
