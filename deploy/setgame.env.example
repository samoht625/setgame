# Production loopback backend for Caddy (set.tido.site -> 127.0.0.1:7778)
# Copy to deploy/setgame.env (gitignored). Do not commit secrets.
#
# scripts/set-prod.sh / ensure-prod-env.sh will append missing keys on deploy.
# Do not put the SQLite file inside the git checkout.
PORT=7778
RAILS_ENV=production
RAILS_LOG_TO_STDOUT=1
RAILS_LOG_LEVEL=info
# Required in production after config/master.key was removed from git:
# RAILS_MASTER_KEY=your_32_byte_hex_master_key

# Absolute path outside the checkout (set-prod defaults to $HOME/www/setgame-data/...).
# DATABASE_PATH=/home/YOU/www/setgame-data/production.sqlite3

# Must stay 1: in-memory GAME_ENGINE + SQLite writes assume one Puma process.
WEB_CONCURRENCY=1
RAILS_MAX_THREADS=3
