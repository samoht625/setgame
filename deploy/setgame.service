[Unit]
Description=Set Game production server (Caddy backend on 127.0.0.1:7778)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/www/setgame
EnvironmentFile=-%h/www/setgame/deploy/setgame.env
# Wrappers load/create DATABASE_PATH and avoid hardcoded vendor/bundle/ruby/X.Y.Z paths.
ExecStartPre=%h/www/setgame/scripts/setgame-start-pre.sh
ExecStart=%h/www/setgame/scripts/setgame-run-puma.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
