<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>Set Sign In</title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="robots" content="noindex">
    <meta name="referrer" content="same-origin">
    <link rel="icon" href="/icon-32.png" sizes="32x32" type="image/png">
    <%= csrf_meta_tags %>
    <style>
      :root{color-scheme:light dark}
      body{margin:0;min-height:100dvh;display:flex;align-items:center;justify-content:center;background:#f5f5f5;color:#171717;font:15px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",system-ui,sans-serif}
      .card{width:min(22rem,calc(100vw - 2rem));box-sizing:border-box;background:#fff;border:1px solid #e5e5e5;border-radius:16px;padding:28px 24px;text-align:center;box-shadow:0 1px 2px rgba(0,0,0,.04)}
      .logo{font-size:17px;font-weight:600;letter-spacing:-.01em}
      .dot{display:inline-block;width:6px;height:6px;border-radius:3px;margin-left:3px;vertical-align:middle}
      h1{margin:18px 0 0;font-size:16px;font-weight:600}
      p{margin:6px 0 20px;color:#525252;font-size:14px}
      .status{margin:16px 0 0;display:flex;align-items:center;justify-content:center;gap:8px}
      .spinner{width:14px;height:14px;border-radius:50%;border:2px solid #d4d4d4;border-top-color:#525252;animation:spin .8s linear infinite}
      @keyframes spin{to{transform:rotate(360deg)}}
      form{margin:0}noscript .btn{margin-top:16px}.logo+p{margin-top:16px}
      .btn{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 24px;border-radius:999px;font:500 14px/1 inherit;font-family:inherit;text-decoration:none;cursor:pointer;border:1px solid transparent}
      .primary{background:#171717;color:#fff}.primary:hover{background:#404040}
      .secondary{background:#fff;color:#404040;border-color:#d4d4d4}.secondary:hover{background:#f5f5f5}
      @media (prefers-color-scheme:dark){
        body{background:#111214;color:#f5f5f5}
        .card{background:#171717;border-color:#404040}
        p{color:#a3a3a3}
        .spinner{border-color:#404040;border-top-color:#d4d4d4}
        .primary{background:#f5f5f5;color:#171717}.primary:hover{background:#d4d4d4}
        .secondary{background:#171717;color:#e5e5e5;border-color:#525252}.secondary:hover{background:#262626}
      }
    </style>
  </head>
  <body>
    <main class="card">
      <a href="/" class="logo" style="color:inherit;text-decoration:none">Set<span class="dot" style="background:#ef4444;margin-left:6px"></span><span class="dot" style="background:#9333ea"></span><span class="dot" style="background:#16a34a"></span></a>
      <%= yield %>
    </main>
  </body>
</html>
