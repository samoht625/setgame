<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>Set · Stats</title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="description" content="What sets people find, and how fast.">
    <link rel="icon" href="/icon-32.png" sizes="32x32" type="image/png">
    <% if Rails.env.production? %>
      <script defer src="https://analytics.tido.site/script.js" data-website-id="b4235c8a-975d-4920-85d3-0a87a4af920c"></script>
    <% end %>
    <style>
      :root{color-scheme:light dark}
      body{margin:0;background:#f5f5f5;color:#171717;font:15px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",system-ui,sans-serif}
      main{max-width:600px;margin:0 auto;padding:28px 18px 56px}
      a{color:inherit}
      header{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:22px}
      h1{font-size:22px;margin:0;font-weight:650;letter-spacing:-.01em}
      h2{font-size:13px;text-transform:uppercase;letter-spacing:.08em;color:#8a8a8a;font-weight:600;margin:34px 0 12px}
      .muted{color:#8a8a8a;font-size:13px}
      .tiles{display:grid;grid-template-columns:1fr 1fr;gap:10px}
      .tile{background:#fff;border-radius:14px;padding:14px 16px;box-shadow:0 0 0 1px #e8e8e8}
      .tile b{display:block;white-space:nowrap;font-size:24px;font-weight:650;font-variant-numeric:tabular-nums}
      .tile span{font-size:12.5px;color:#777}
      .bars{background:#fff;border-radius:14px;padding:8px 16px;box-shadow:0 0 0 1px #e8e8e8}
      .bar{display:grid;grid-template-columns:118px 1fr 92px;align-items:center;gap:10px;padding:7px 0;font-size:13.5px}
      .bar+.bar{border-top:1px solid #f0f0f0}
      .track{position:relative;height:10px;background:#f1f1f1;border-radius:6px}
      .fill{position:absolute;inset:0 auto 0 0;background:#262626;border-radius:6px}
      .tick{position:absolute;top:-3px;bottom:-3px;width:2px;background:#e11d48;border-radius:1px}
      .num{text-align:right;font-variant-numeric:tabular-nums}
      .hf{padding:12px 16px 30px}
      .hf-title{font-size:12px;margin-bottom:4px}
      .hf-row{display:grid;grid-template-columns:auto 1fr auto;align-items:center;column-gap:10px;row-gap:6px;padding:9px 0}
      .hf-row+.hf-row{border-top:1px solid #f0f0f0}
      .hf-row .c{width:34px;height:22px;border-radius:4px}
      .hf-row .set{gap:3px}
      .hf-label{font-size:13.5px}
      .hf-label small{display:block;color:#999;font-size:11px}
      .hf-track{grid-column:1/-1;position:relative;height:10px}
      .hf-tick{position:absolute;top:0;bottom:0;width:1px;background:#ececec}
      .hf-ref{position:absolute;top:-3px;bottom:-3px;border-left:1px dashed #b5b5b5}
      .hf-fill{position:absolute;left:0;top:4px;height:2px;background:#d4d4d4;border-radius:1px}
      .hf-dot{position:absolute;top:0;width:10px;height:10px;margin-left:-5px;border-radius:50%;background:#262626}
      .hf-axis{position:relative;height:14px;font-size:11px;margin-top:4px}
      .hf-axis span{position:absolute;transform:translateX(-50%)}
      .hf-axis span:first-child{transform:none}
      .hf-axis span:last-child{transform:translateX(-100%)}
      .list{display:grid;grid-template-columns:1fr;gap:8px}
      .row{display:flex;align-items:center;gap:8px;background:#fff;border-radius:12px;padding:8px 10px;box-shadow:0 0 0 1px #ececec}
      .row .k{width:20px;color:#a3a3a3;font-size:12.5px;font-variant-numeric:tabular-nums}
      .row .v{margin-left:auto;font-weight:600;font-size:13.5px;font-variant-numeric:tabular-nums;text-align:right}
      .row .v small{display:block;font-weight:400;color:#999;font-size:11px}
      .set{display:inline-flex;gap:5px}
      .c{width:66px;height:43px;background:#fff;border-radius:6px;box-shadow:0 0 0 1px #e3e3e3}
      .facts{display:grid;grid-template-columns:1fr;gap:10px}
      .fact{background:#fff;border-radius:14px;padding:12px 14px;box-shadow:0 0 0 1px #e8e8e8;font-size:13.5px}
      .fact .set{margin-top:8px}
      @media (max-width:640px){.tile b{font-size:21px}.bar{grid-template-columns:96px 1fr 78px}.c{width:58px;height:38px}}
      @media (prefers-color-scheme:dark){
        body{background:#111214;color:#eee}.tile,.bars,.row,.fact{background:#1b1c1f;box-shadow:0 0 0 1px #2a2b2f}
        .bar+.bar,.hf-row+.hf-row{border-top-color:#26272a}.hf-tick{background:#2a2b2f}.hf-fill{background:#4a4b50}.hf-dot{background:#e5e5e5}.track{background:#2a2b2f}.fill{background:#e5e5e5}.c{background:#f1f0ec}
      }
    </style>
  </head>
  <body><%= yield %></body>
</html>
