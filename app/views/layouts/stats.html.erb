<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>Set Stats</title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="description" content="Set Stats">
    <link rel="icon" href="/icon-32.png" sizes="32x32" type="image/png">
    <%= csrf_meta_tags %>
    <%= render "home/identity" %>
    <%= stylesheet_link_tag "application" %>
    <%= javascript_include_tag "application", type: "module" %>
    <% if Rails.env.production? %>
      <script defer src="https://analytics.tido.site/script.js" data-website-id="b4235c8a-975d-4920-85d3-0a87a4af920c"></script>
    <% end %>
    <style>
      :root{color-scheme:light dark}
      body{margin:0;background:#f5f5f5;color:#171717;font:15px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",system-ui,sans-serif}
      main{max-width:600px;margin:0 auto;padding:0 18px 56px}
      p{margin:1em 0}
      a{color:inherit}
      h1{font-size:20px;margin:4px 0 16px;font-weight:600;letter-spacing:-.01em}
      h2{font-size:13px;text-transform:uppercase;letter-spacing:.08em;color:#8a8a8a;font-weight:600;margin:34px 0 12px}
      .muted{color:#8a8a8a;font-size:13px}
      .btn{display:inline-flex;align-items:center;min-height:36px;padding:0 16px;border-radius:999px;border:1px solid #d4d4d4;background:#fff;color:#404040;font-size:13px;font-weight:500;text-decoration:none;transition:background-color .15s}.btn:hover{background:#f5f5f5}
      .tiles{display:grid;grid-template-columns:1fr 1fr;gap:10px}
      .tile{background:#fff;border-radius:14px;padding:14px 16px;box-shadow:0 0 0 1px #e8e8e8}
      .tile b{display:block;white-space:nowrap;font-size:24px;font-weight:650;font-variant-numeric:tabular-nums}
      .tile span{font-size:12.5px;color:#777}
      .bars{background:#fff;border-radius:14px;padding:8px 16px;box-shadow:0 0 0 1px #e8e8e8}
      .bar{display:grid;grid-template-columns:118px 1fr 92px;align-items:center;gap:10px;padding:7px 0;font-size:13.5px}
      .bar+.bar{border-top:1px solid #f0f0f0}
      .track{position:relative;height:10px;background:#f1f1f1;border-radius:6px}
      .fill{position:absolute;inset:0 auto 0 0;background:#262626;border-radius:6px}
      .tick{position:absolute;top:-3px;bottom:-3px;width:2px;background:#e11d48;border-radius:1px}
      .num{text-align:right;font-variant-numeric:tabular-nums}
      .hf-axis{position:relative;height:14px;font-size:11px;margin-top:4px}
      .hf-axis span{position:absolute;transform:translateX(-50%)}
      .hf-axis span:first-child{transform:none}
      .hf-axis span:last-child{transform:translateX(-100%)}
      .kinds{display:grid;grid-template-columns:1fr 1fr;gap:10px}
      .kind{display:flex;flex-direction:column;gap:8px;background:#fff;border-radius:14px;padding:12px 14px 14px;box-shadow:0 0 0 1px #e8e8e8;min-width:0}
      .kind-label{font-size:12.5px;color:#777}
      .kind .set{gap:4px}
      .kind .c{width:72px;height:47px}
      .kind-med{font-size:24px;font-weight:650;font-variant-numeric:tabular-nums;line-height:1.1}
      .kind-track{position:relative;height:6px;background:#f1f1f1;border-radius:3px;margin:4px 0}
      .kind-tick{position:absolute;top:0;bottom:0;width:2px;margin-left:-1px;background:#fff}
      .kind-iqr{position:absolute;top:-4px;height:14px;background:#c4c4c4;border-radius:4px}
      .kind-mid{position:absolute;top:-8px;height:22px;width:4px;margin-left:-2px;background:#262626;border-radius:2px}
      .spread{padding:14px 16px 10px}
      .hist{display:flex;align-items:flex-end;gap:2px;height:72px}
      .hist span{flex:1;background:#d4d4d4;border-radius:2px 2px 0 0}
      .hist span.x{background:#262626}
      .list{display:grid;grid-template-columns:1fr;gap:8px}
      .row{display:flex;align-items:center;gap:8px;background:#fff;border-radius:12px;padding:8px 10px;box-shadow:0 0 0 1px #ececec}
      .row .k{width:20px;color:#a3a3a3;font-size:12.5px;font-variant-numeric:tabular-nums}
      .row .v{margin-left:auto;font-weight:600;font-size:13.5px;font-variant-numeric:tabular-nums;text-align:right}
      .row .v small{display:block;font-weight:400;color:#999;font-size:11px}
      .set{display:inline-flex;gap:5px}
      .c{width:66px;height:43px;background:#fff;border-radius:6px;box-shadow:0 0 0 1px #e3e3e3}
      .facts{display:grid;grid-template-columns:1fr;gap:10px}
      .fact{background:#fff;border-radius:14px;padding:12px 14px;box-shadow:0 0 0 1px #e8e8e8;font-size:13.5px}
      .fact .set{margin-top:8px}
      @media (max-width:640px){.tile b{font-size:21px}.kind{padding:10px 11px 12px}.kind .set{gap:3px}.kind .c{width:min(72px,calc((100vw - 102px) / 6));height:auto;aspect-ratio:258/167}.kind-med{font-size:21px}.bar{grid-template-columns:96px 1fr 78px}.c{width:58px;height:38px}}
      @media (prefers-color-scheme:dark){
        body{background:#111214;color:#eee}.btn{background:#1b1c1f;border-color:#525252;color:#e5e5e5}.btn:hover{background:#26272a}.tile,.bars,.row,.fact,.kind{background:#1b1c1f;box-shadow:0 0 0 1px #2a2b2f}
        .bar+.bar{border-top-color:#26272a}.kind-track{background:#2a2b2f}.kind-tick{background:#1b1c1f}.kind-iqr{background:#5a5b60}.kind-mid,.hist span.x{background:#e5e5e5}.hist span{background:#4a4b50}.track{background:#2a2b2f}.fill{background:#e5e5e5}.c{background:#f1f0ec}
      }
    </style>
  </head>
  <body><div id="site-header"><%= prerendered(:stats) %></div><%= yield %></body>
</html>
