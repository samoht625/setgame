<% content_for :title, "Set Daily Deal · Play the Set Card Game Online" %>
<% content_for :description, "Play Set, the card game of spotting sets, free in your browser. A new Daily Deal every day: the same deal for everyone, one try, on today’s leaderboard. No signup, no download." %>
<% content_for :canonical, "#{ApplicationHelper::SITE_URL}/" %>
<% content_for :head, render("home/identity") + render("home/boot") + render("home/structured_data") %>
<% if @shared_result %>
  <% content_for :social_title, "#{@shared_result.title} · #{@shared_result.time}" %>
  <% content_for :social_description, @shared_result.standing.presence || @shared_result.title %>
  <% content_for :social_url, "#{ApplicationHelper::SITE_URL}/daily?r=#{@shared_result.token}" %>
  <% content_for :social_image, "#{ApplicationHelper::SITE_URL}#{daily_og_image_path(@shared_result.token)}" %>
  <% content_for :social_image_alt, ["#{@shared_result.title} · #{@shared_result.time}", @shared_result.standing.presence].compact.join(" · ") %>
<% end %>
<div id="root" data-online-ids="<%= GAME_ENGINE.online_player_ids_snapshot.to_json %>"><%= prerendered(:daily) %></div>
