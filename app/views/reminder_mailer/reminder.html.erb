<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="light">
    <title><%= @headline %></title>
  </head>
  <body style="margin:0;padding:0;background:#f5f5f5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',system-ui,sans-serif;color:#171717;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f5f5f5;">
      <tr>
        <td align="center" style="padding:32px 16px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:400px;background:#ffffff;border:1px solid #e5e5e5;border-radius:16px;">
            <tr>
              <td align="center" style="padding:28px 24px 26px;">
                <div style="font-size:17px;font-weight:600;letter-spacing:-0.01em;">
                  Set
                  <span style="display:inline-block;width:6px;height:6px;border-radius:3px;background:#ef4444;margin-left:4px;vertical-align:middle;"></span>
                  <span style="display:inline-block;width:6px;height:6px;border-radius:3px;background:#9333ea;margin-left:2px;vertical-align:middle;"></span>
                  <span style="display:inline-block;width:6px;height:6px;border-radius:3px;background:#16a34a;margin-left:2px;vertical-align:middle;"></span>
                </div>
                <p style="margin:18px 0 0;font-size:16px;line-height:1.45;font-weight:600;color:#171717;"><%= @headline %></p>
                <% if @streak || @also %>
                  <p style="margin:6px 0 0;font-size:14px;line-height:1.45;color:#525252;"><%= [@streak, @also].compact.join(" ") %></p>
                <% end %>
                <p style="margin:22px 0 0;"><a href="<%= @play_url %>" style="display:inline-block;padding:12px 32px;border-radius:999px;background:#171717;color:#ffffff;font-size:15px;font-weight:500;text-decoration:none;">Play</a></p>
                <p style="margin:24px 0 0;font-size:12px;line-height:1.5;color:#8a8a8a;">Your reminder for <%= @time_label %> on days you haven’t played.<br><a href="<%= @unsubscribe_url %>" style="color:#8a8a8a;">Unsubscribe</a></p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
