<% s = @stats %>
<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
  <path id="st-squiggle" d="M-10-54 C7-54 22.5-41 22.5-19 C22.5-4.5 15 2.5 15 11.5 C15 23.5 25.5 32.5 25.5 39.5 C25.5 46.5 15 50.5 6 50.5 C-13 50.5-23.5 39.5-23.5 22.5 C-23.5 6.5-13.5-6.5-13.5-18 C-13.5-30.5-24.5-40-24.5-45.5 C-24.5-51-17-54-10-54 Z"/>
  <path id="st-diamond" d="M0-59 28 0 0 59-28 0Z"/>
  <rect id="st-oval" x="-26.5" y="-55" width="53" height="110" rx="26.5"/>
  <% StatsHelper::INKS.each do |name, ink| %><pattern id="st-<%= name %>" width="12" height="12" patternUnits="userSpaceOnUse"><path d="M0 3H12" fill="none" stroke="<%= ink %>" stroke-width="3.5"/></pattern><% end %>
</defs></svg>
<main>
  <h1>Stats</h1>

  <div class="tiles">
    <div class="tile"><b><%= number_with_delimiter(s[:total_incl_unfinished]) %></b><span>sets found</span></div>
    <div class="tile"><b><%= number_with_delimiter(s[:players]) %></b><span>players</span></div>
    <div class="tile"><b><%= number_with_delimiter(s[:runs]) %></b><span>games finished</span></div>
    <div class="tile"><b><%= s[:spread][:min][:n] %>× – <%= s[:spread][:max][:n] %>×</b><span>finds per set, min–max</span></div>
  </div>

  <% if s[:most_games].present? %>
    <h2>Most games finished</h2>
    <p class="muted">Named players, Practice + Daily Deal.</p>
    <div class="list">
      <% s[:most_games].each_with_index do |p, i| %>
        <div class="row"><span class="k"><%= i + 1 %></span><span><%= p[:name] %></span><span class="v"><%= p[:total] %><small><%= p[:solo] %> practice · <%= p[:daily] %> daily deal</small></span></div>
      <% end %>
    </div>
  <% end %>

  <h2>How fast</h2>
  <p class="muted">Median seconds to find a set, by which attributes are all different. Bar: middle half of finds, 0–20s.</p>
  <% kmax = 20_000; kpos = ->(ms) { (ms.clamp(0, kmax) * 100.0 / kmax).round(2) } %>
  <div class="kinds">
    <% s[:kinds].each do |k| %>
      <div class="kind">
        <span class="kind-label"><%= k[:label] %></span>
        <%= set_cards(k[:cards]) if k[:cards] %>
        <b class="kind-med"><%= format("%.1fs", k[:median_ms] / 1000.0) %></b>
        <span class="kind-track" aria-label="middle half <%= secs(k[:p25_ms]) %> to <%= secs(k[:p75_ms]) %>" title="<%= secs(k[:p25_ms]) %> – <%= secs(k[:p75_ms]) %> · <%= number_with_delimiter(k[:n]) %> finds">
          <% [5_000, 10_000, 15_000].each do |t| %><span class="kind-tick" style="left:<%= kpos.(t) %>%"></span><% end %>
          <span class="kind-iqr" style="left:<%= kpos.(k[:p25_ms]) %>%;width:<%= (kpos.(k[:p75_ms]) - kpos.(k[:p25_ms])).round(2) %>%"></span>
          <span class="kind-mid" style="left:<%= kpos.(k[:median_ms]) %>%"></span>
        </span>
      </div>
    <% end %>
  </div>

  <% if s[:fastest].any? %>
    <h2>Quickest to spot</h2>
    <p class="muted">Lowest median find time, among sets found at least <%= SetStats::MIN_SAMPLE %> times.</p>
    <div class="list">
      <% s[:fastest].each_with_index do |f, i| %>
        <div class="row"><span class="k"><%= i + 1 %></span><%= set_cards(f[:cards]) %><span class="v"><%= secs(f[:median_ms]) %><small><%= f[:n] %> finds</small></span></div>
      <% end %>
    </div>
  <% end %>

  <h2>What gets found</h2>
  <p class="muted">Share of finds by how many attributes are all different. Red tick: share among all 1,080 possible sets.</p>
  <div class="bars">
    <% total = [s[:total_finds], 1].max %>
    <% (1..4).each do |n| pct = s[:type_counts][n] * 100.0 / total %>
      <div class="bar"><span><%= n %> different</span><span class="track"><span class="fill" style="width:<%= (pct * 2).clamp(0, 100).round(1) %>%"></span><span class="tick" style="left:<%= SetStats::CHANCE[n] * 2 %>%"></span></span><span class="num"><%= pct.round(1) %>% <span class="muted">/ <%= SetStats::CHANCE[n] %>%</span></span></div>
    <% end %>
  </div>

  <% sp = s[:spread]; peak = [sp[:hist].map(&:last).max, 1].max %>
  <h2>Finds per set</h2>
  <p class="muted">How many of the <%= number_with_delimiter(SetStats::TOTAL_SETS) %> possible sets have been found each number of times. Median: <%= sp[:median] %>×.</p>
  <div class="bars spread">
    <div class="hist" aria-hidden="true">
      <% sp[:hist].each do |n, sets| %><span class="<%= "x" if n == sp[:min][:n] || n == sp[:max][:n] %>" style="height:<%= sets.zero? ? 0 : [(sets * 100.0 / peak).round(1), 3].max %>%" title="<%= n %>×: <%= sets %> sets"></span><% end %>
    </div>
    <div class="hf-axis muted" aria-hidden="true"><span style="left:0"><%= sp[:min][:n] %>×</span><span style="left:100%"><%= sp[:max][:n] %>×</span></div>
  </div>

  <h2>Most found</h2>
  <div class="list">
    <% s[:most_found].each_with_index do |f, i| %>
      <div class="row"><span class="k"><%= i + 1 %></span><%= set_cards(f[:cards]) %><span class="v"><%= f[:n] %>×</span></div>
    <% end %>
  </div>

  <h2>Least found</h2>
  <div class="list">
    <% sp[:least].each_with_index do |f, i| %>
      <div class="row"><span class="k"><%= i + 1 %></span><%= set_cards(f[:cards]) %><span class="v"><%= f[:n] %>×</span></div>
    <% end %>
  </div>

  <h2>Fun facts</h2>
  <div class="facts">
    <% if s[:fastest_find] %><div class="fact">Fastest find ever: <b><%= secs(s[:fastest_find][:ms]) %></b><br><%= set_cards(s[:fastest_find][:cards]) %></div><% end %>
    <% if s[:drought] %><div class="fact">Longest drought between finds: <b><%= secs(s[:drought][:ms]) %></b>, ended by<br><%= set_cards(s[:drought][:cards]) %></div><% end %>
    <div class="fact">
      Practice: <b><%= s[:modes]["solo"][:runs] %></b> finished, median <b><%= secs(s[:modes]["solo"][:median_ms]) %></b><br>
      Daily Deal: <b><%= s[:modes]["daily"][:runs] %></b> finished, median <b><%= secs(s[:modes]["daily"][:median_ms]) %></b>
      <% if s[:busiest_day] %><br>Busiest day: <b><%= s[:busiest_day][0].strftime("%b %-d") %></b> (<%= s[:busiest_day][1] %> games)<% end %>
      <% if s[:busiest_hour] %><br>Busiest hour: <b><%= Time.new(2000, 1, 1, s[:busiest_hour]).strftime("%-l %p") %> CT</b><% end %>
    </div>
  </div>
</main>
