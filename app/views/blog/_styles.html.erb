<%# The blog's own type, on top of the stats layout's colors and charts: one readable column at every width. %>
<style>
  main.blog{max-width:720px}
  .prose a:not(.btn){text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px}
  main.blog .top{margin-bottom:22px}
  main.blog h1{font-size:26px;line-height:1.2;letter-spacing:-.02em;text-wrap:balance}
  main.blog h2{font-size:19px;line-height:1.3}
  .crumb{margin:0 0 10px;color:var(--muted);font-size:13.5px}
  .crumb a{text-decoration:none}
  .crumb a:hover{text-decoration:underline}
  main.blog .dateline{margin-top:8px;font-size:13.5px;text-wrap:balance}
  .prose{margin:0 2px}
  .prose p{margin:0;font-size:16.5px;line-height:1.6;text-wrap:pretty}
  .prose p+p{margin-top:14px}
  .prose h2{margin:34px 0 8px}
  .prose figure{margin:26px -2px 0}
  .prose figcaption{margin:9px 2px 0;color:var(--muted);font-size:13px;line-height:1.45}
  .prose .closing{margin-top:30px;padding-top:24px;border-top:1px solid var(--line)}
  .prose .more{display:flex;flex-wrap:wrap;align-items:center;gap:8px 18px;margin-top:26px;font-size:14.5px}
  .prose .more .btn{font-size:14.5px;min-height:40px;padding:0 18px}
  .posts{list-style:none;margin:0;padding:0}
  .posts li{padding:16px 18px 17px}
  .posts li+li{border-top:1px solid var(--hair)}
  .posts h2 a{text-decoration:none}
  .posts h2 a:hover{text-decoration:underline}
  .posts p{margin:5px 0 0;color:var(--muted);font-size:14.5px;line-height:1.5}
  .posts time{display:block;margin-bottom:4px;color:var(--faint);font-size:12.5px}
  @media (min-width:760px){
    main.blog h1{font-size:32px}
    main.blog h2{font-size:21px}
    .prose p{font-size:17px}
    .prose h2{margin-top:40px}
  }
</style>
