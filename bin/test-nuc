#!/usr/bin/env bash
# Runs the test suites on the NUC (or any box) without touching the production
# bundle. Production installs with BUNDLE_WITHOUT=development:test, so the test
# group (debug, minitest helpers) is missing there; this script keeps its own
# bundle config and gem path for the full Gemfile.
#
#   bin/test-nuc            # Rails tests + TypeScript + node rule checks
#   bin/test-nuc --browser  # also Playwright against a local test server
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

export BUNDLE_APP_CONFIG="$ROOT/tmp/test-bundle-config"
export BUNDLE_PATH="${SETGAME_TEST_BUNDLE_PATH:-$HOME/.cache/setgame-test-bundle}"
export BUNDLE_WITHOUT="" BUNDLE_DEPLOYMENT=false BUNDLE_FROZEN=true
export RAILS_ENV=test
unset DATABASE_PATH
mkdir -p "$BUNDLE_APP_CONFIG"
BUNDLE="ruby -S bundle"

$BUNDLE check >/dev/null 2>&1 || $BUNDLE install --quiet
[ -d node_modules ] || npm ci --no-audit --no-fund

fail=0
step() { echo "== $*"; "$@" || fail=1; }
step $BUNDLE exec ruby bin/rails db:prepare
step $BUNDLE exec ruby bin/rails test
step npx --no-install tsc --noEmit
for s in test:rules test:daily test:cards; do step npm run --silent "$s"; done

if [ "${1:-}" = "--browser" ]; then
  # Playwright has no build for Ubuntu 26.04 yet; the 24.04 build works.
  PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=${PLAYWRIGHT_HOST_PLATFORM_OVERRIDE:-ubuntu24.04-x64} \
    npx --no-install playwright install chromium >/dev/null || echo "warning: playwright install failed"
  npm run --silent build && npm run --silent build:css
  PORT=${PORT:-3999}
  $BUNDLE exec ruby bin/rails server -p "$PORT" -b 127.0.0.1 >tmp/test-server.log 2>&1 &
  srv=$!
  trap 'kill $srv 2>/dev/null' EXIT
  for _ in $(seq 60); do curl -sf "http://127.0.0.1:$PORT/up" >/dev/null && break; sleep 1; done
  PLAYWRIGHT_BASE_URL="http://127.0.0.1:$PORT" step npx --no-install playwright test
fi
exit $fail
